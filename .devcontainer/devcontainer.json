{
  "name": "Base images",
  "image": "mcr.microsoft.com/devcontainers/base:2.2.5-trixie@sha256:71b6fe7c4e07ec747a94a72b2a17f2f8c286eaa7b1c59862888df764efb8b6c6",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "moby": false,
      "version": "29.3.1"
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/daemon.json,target=/etc/docker/daemon.json,type=bind,readonly"
  ],
  "postStartCommand": ".devcontainer/post-start.sh"
}
